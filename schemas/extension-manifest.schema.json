# Esquema del manifiesto de una extension de Liora.
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionManifest",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "version", "type", "permissions", "entrypoint"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "displayName": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "homepage": { "type": "string" },
    "icon": { "type": "string" },
    "minLioraVersion": { "type": "string" },
    "requiredFeatures": { "type": "array", "items": { "type": "string" } },
    "type": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "metadata_provider",
          "track_search_provider",
          "audio_source_provider",
          "audio_download_provider",
          "lyrics_provider"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "required": ["network"],
      "properties": {
        "network": { "type": "array", "items": { "type": "string" } },
        "storage": { "type": "boolean" },
        "file": { "type": "boolean" }
      }
    },
    "entrypoint": { "type": "string", "description": "Ruta relativa dentro del paquete." }
  }
}
